# OpenRouter — only the API key is required.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: comma-separated model chain, tried in order until one succeeds.
# Leave blank to use the built-in chain of free models (see app/config.py).
# OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free

REQUEST_TIMEOUT_SECONDS=60

# Embeddings (local HuggingFace sentence-transformer, no API key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector store
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=stripe_docs

# Retrieval / confidence
RETRIEVAL_TOP_K=5
CONFIDENCE_THRESHOLD=0.6
