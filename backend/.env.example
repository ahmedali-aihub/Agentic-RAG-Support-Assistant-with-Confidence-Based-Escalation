# ── OpenRouter ────────────────────────────────────────────────────────────────
# Comma-separate keys from DIFFERENT accounts. Each account has its own daily
# free-model allowance (~50/day), so a second key is genuinely more capacity.
# No quotes, no spaces around the commas.
#
#   OPENROUTER_API_KEY=sk-or-v1-AAA...,sk-or-v1-BBB...,sk-or-v1-CCC...
#
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: override the model chain (comma-separated, tried in order).
# Leave blank to use the built-in 16 free models in app/config.py.
# OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free


# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get keys at https://aistudio.google.com/apikey — the free tier is far larger
# than OpenRouter's, so these are tried after it, as reserve capacity.
# Comma-separate several keys the same way.
#
#   GEMINI_API_KEY=AIza-AAA...,AIza-BBB...
#
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Optional: override the Gemini model chain.
# GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash


# ── Timeouts ──────────────────────────────────────────────────────────────────
REQUEST_TIMEOUT_SECONDS=60


# ── Embeddings (local HuggingFace model, no API key needed) ───────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2


# ── Vector store ──────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=stripe_docs


# ── Retrieval and confidence ──────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=20
CONFIDENCE_THRESHOLD=0.6
RERANK_ENABLED=true
QUERY_REWRITE_ENABLED=true
