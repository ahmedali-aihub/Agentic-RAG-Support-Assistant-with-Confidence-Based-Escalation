# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Env
.env
.env.local

# Generated eval output. These are build artifacts, not source, and they embed
# whole model answers -- which quote example credentials straight out of the
# docs and trip GitHub's secret scanning.
backend/scripts/comparison_results.json
backend/scripts/eval_results.json

# Data (large/generated)
backend/data/raw/*
backend/data/processed/*
backend/data/chroma_db/*
!backend/data/raw/.gitkeep
!backend/data/processed/.gitkeep
!backend/data/chroma_db/.gitkeep

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Playwright capture artifacts (screenshots are committed, raw video is not)
docs/media/*.webm
frontend/test-results/
frontend/playwright-report/
